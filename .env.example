# Google Gemini AI API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
# NOTE: Copy this file to '.env' and paste your real key there. Never commit your '.env' file!
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# HTTP Server Port
PORT=3000

# Admin PIN for Protected Operations (Publish & Rollback)
ADMIN_UPLOAD_PIN=1234

# Optional Database URL (defaults to local SQLite 'data/portfolio.db')
# For Production (Neon / Supabase / Render PostgreSQL):
# DATABASE_URL=postgresql://user:password@ep-sample-12345.neon.tech/neondb?sslmode=require

