# HTTP Server Port (Local: 8000, Render: injected via $PORT)
PORT=8000

# Google Gemini AI API Key (Required for AI Resume Structuring)
GEMINI_API_KEY=your_gemini_api_key_here

# Admin Security PIN for Protected Operations (Publish & Rollback)
ADMIN_UPLOAD_PIN=1234

# GitHub Cloud Persistence (Optional for Render.com free ephemeral disk sync)
GITHUB_TOKEN=your_personal_access_token_here
GITHUB_REPO=your_username/your_portfolio_repo
GITHUB_BRANCH=main
